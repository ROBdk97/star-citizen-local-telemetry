<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net11.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;RS0016;RS0017;RS0025;RS0026;RS0027</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Label="NuGet">
		<PackageId>ROBdk97.ScLocalTelemetry</PackageId>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
		<Authors>ROBdk97</Authors>
		<Copyright>Copyright (c) 2026 ROBdk97</Copyright>
		<Title>Star Citizen Local Telemetry</Title>
		<Description>Experimental, unofficial .NET client for Star Citizen's local gRPC telemetry service: stream vehicle, actor, weapon and event telemetry as C# records, and discover and trigger in-game actions. Not affiliated with Cloud Imperium Games or RSI.</Description>
		<PackageTags>star-citizen;telemetry;grpc;gaming;force-feedback</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/ROBdk97/star-citizen-local-telemetry</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ROBdk97/star-citizen-local-telemetry</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>See https://github.com/ROBdk97/star-citizen-local-telemetry/blob/main/CHANGELOG.md. Schema compatible with StarCitizen.exe 5.0.202.10025 (PTU).</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\sc_telemetry_types.proto" GrpcServices="Both" Access="Internal" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
		<PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
		<PackageReference Include="Grpc.Tools" Version="2.85.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
	</ItemGroup>

	<!-- Lowest versions that work, so net8.0/net9.0 apps aren't forced onto 11.0 packages
	     (which warn that they don't support those frameworks). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>

</Project>
